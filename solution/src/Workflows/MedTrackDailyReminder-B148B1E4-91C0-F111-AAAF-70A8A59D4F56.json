                    "scheduledWeekday": "@mod(add(sub(coalesce(items('ForEachMedication')?['ppa_scheduledday'], 894250000), 894250000), 1), 7)",
                    "todayNumber": "@div(ticks(outputs('Today')), 864000000000)",
                    "anchorNumber": "@div(ticks(substring(coalesce(items('ForEachMedication')?['ppa_startdate'], convertFromUtc(items('ForEachMedication')?['createdon'], parameters('ppa_ReminderTimeZone (ppa_ReminderTimeZone)'), 'yyyy-MM-dd')), 0, 10)), 864000000000)",
                    "hasTaken": "@greater(length(body('LatestTaken')?['value']), 0)",
                    "hasSkipped": "@greater(length(body('LatestSkipped')?['value']), 0)",
                    "takenNumber": "@div(ticks(convertFromUtc(coalesce(first(body('LatestTaken')?['value'])?['ppa_loggedat'], '1900-01-01T12:00:00Z'), parameters('ppa_ReminderTimeZone (ppa_ReminderTimeZone)'), 'yyyy-MM-dd')), 864000000000)",
