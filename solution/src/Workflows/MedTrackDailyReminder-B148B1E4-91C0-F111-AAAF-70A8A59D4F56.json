                                "line": "@concat('<li>', replace(replace(outputs('Facts')?['name'], '&', '&amp;'), '<', '&lt;'), ' — ', replace(replace(outputs('Facts')?['dosage'], '&', '&amp;'), '<', '&lt;'), ' — was due ', addDays(outputs('Today'), mul(outputs('PastDue')?['daysPastDue'], -1), 'ddd, MMM d'), ' (', string(outputs('PastDue')?['daysPastDue']), if(equals(outputs('PastDue')?['daysPastDue'], 1), ' day ago)', ' days ago)'), if(outputs('Facts')?['isInjection'], concat('<br>', if(outputs('Facts')?['hasTaken'], concat('Last taken ', convertFromUtc(outputs('Facts')?['takenAt'], parameters('ppa_ReminderTimeZone (ppa_ReminderTimeZone)'), 'ddd, MMM d'), if(equals(outputs('Facts')?['takenSite'], ''), '', concat(' · ', outputs('Facts')?['takenSite']))), 'Not yet taken')), ''), '</li>')"
