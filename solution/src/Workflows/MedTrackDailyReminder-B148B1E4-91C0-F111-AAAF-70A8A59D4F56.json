                "else": {
                  "actions": {
                    "AlreadyRanToday": {
                      "type": "Terminate",
                      "inputs": {
                        "runStatus": "Succeeded"
                      },
                      "runAfter": {}
                    }
                  }
                },
                "runAfter": {}
              }
            }
          },
          "runAfter": {
            "ReadExistingRun": [
              "Succeeded"
            ]
