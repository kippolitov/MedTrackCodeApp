            "frequency": "Hour",
            "interval": 1,
            "startTime": "2026-01-01T00:00:00Z"
          },
          "conditions": [
            {
              "expression": "@contains(createArray('00', '01', '02', '03'), convertFromUtc(utcNow(), parameters('ppa_ReminderTimeZone (ppa_ReminderTimeZone)'), 'HH'))"
            }
          ],
          "runtimeConfiguration": {
            "concurrency": {
              "runs": 1
            }
          }
        }
      },
      "actions": {
