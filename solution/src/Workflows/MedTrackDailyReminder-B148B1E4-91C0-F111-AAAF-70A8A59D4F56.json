                    "scheduledToday": "@if(equals(outputs('Facts')?['frequency'], 894250000), true, if(equals(outputs('Facts')?['frequency'], 894250001), and(outputs('Facts')?['hasScheduledDay'], equals(mod(add(outputs('Facts')?['todayNumber'], 1), 7), outputs('Facts')?['scheduledWeekday'])), and(greaterOrEquals(sub(outputs('Facts')?['todayNumber'], outputs('Facts')?['anchorNumber']), 0), equals(mod(div(sub(outputs('Facts')?['todayNumber'], outputs('Facts')?['anchorNumber']), 7), 2), 0), equals(mod(add(outputs('Facts')?['todayNumber'], 1), 7), if(outputs('Facts')?['hasScheduledDay'], outputs('Facts')?['scheduledWeekday'], mod(add(outputs('Facts')?['anchorNumber'], 1), 7))))))",
                    "dueToday": "@if(and(outputs('Facts')?['isInjection'], or(outputs('Facts')?['hasTaken'], outputs('Facts')?['hasSkipped'])), equals(add(max(outputs('Facts')?['takenNumber'], outputs('Facts')?['skippedNumber']), outputs('Facts')?['interval']), outputs('Facts')?['todayNumber']), and(if(equals(outputs('Facts')?['frequency'], 894250000), true, if(equals(outputs('Facts')?['frequency'], 894250001), and(outputs('Facts')?['hasScheduledDay'], equals(mod(add(outputs('Facts')?['todayNumber'], 1), 7), outputs('Facts')?['scheduledWeekday'])), and(greaterOrEquals(sub(outputs('Facts')?['todayNumber'], outputs('Facts')?['anchorNumber']), 0), equals(mod(div(sub(outputs('Facts')?['todayNumber'], outputs('Facts')?['anchorNumber']), 7), 2), 0), equals(mod(add(outputs('Facts')?['todayNumber'], 1), 7), if(outputs('Facts')?['hasScheduledDay'], outputs('Facts')?['scheduledWeekday'], mod(add(outputs('Facts')?['anchorNumber'], 1), 7)))))), not(equals(max(outputs('Facts')?['takenNumber'], outputs('Facts')?['skippedNumber']), outputs('Facts')?['todayNumber']))))",
                    "previousDue": "@if(equals(outputs('Facts')?['frequency'], 894250000), if(greaterOrEquals(sub(outputs('Facts')?['todayNumber'], 1), outputs('Facts')?['anchorNumber']), sub(outputs('Facts')?['todayNumber'], 1), 0), if(equals(outputs('Facts')?['frequency'], 894250001), if(and(outputs('Facts')?['hasScheduledDay'], greaterOrEquals(sub(outputs('Facts')?['todayNumber'], add(mod(add(sub(mod(add(outputs('Facts')?['todayNumber'], 1), 7), outputs('Facts')?['scheduledWeekday']), 6), 7), 1)), outputs('Facts')?['anchorNumber'])), sub(outputs('Facts')?['todayNumber'], add(mod(add(sub(mod(add(outputs('Facts')?['todayNumber'], 1), 7), outputs('Facts')?['scheduledWeekday']), 6), 7), 1)), 0), if(and(greaterOrEquals(sub(outputs('Facts')?['todayNumber'], add(mod(add(sub(mod(add(outputs('Facts')?['todayNumber'], 1), 7), if(outputs('Facts')?['hasScheduledDay'], outputs('Facts')?['scheduledWeekday'], mod(add(outputs('Facts')?['anchorNumber'], 1), 7))), 6), 7), 1)), outputs('Facts')?['anchorNumber']), equals(mod(div(sub(sub(outputs('Facts')?['todayNumber'], add(mod(add(sub(mod(add(outputs('Facts')?['todayNumber'], 1), 7), if(outputs('Facts')?['hasScheduledDay'], outputs('Facts')?['scheduledWeekday'], mod(add(outputs('Facts')?['anchorNumber'], 1), 7))), 6), 7), 1)), outputs('Facts')?['anchorNumber']), 7), 2), 0)), sub(outputs('Facts')?['todayNumber'], add(mod(add(sub(mod(add(outputs('Facts')?['todayNumber'], 1), 7), if(outputs('Facts')?['hasScheduledDay'], outputs('Facts')?['scheduledWeekday'], mod(add(outputs('Facts')?['anchorNumber'], 1), 7))), 6), 7), 1)), if(and(greaterOrEquals(sub(sub(outputs('Facts')?['todayNumber'], add(mod(add(sub(mod(add(outputs('Facts')?['todayNumber'], 1), 7), if(outputs('Facts')?['hasScheduledDay'], outputs('Facts')?['scheduledWeekday'], mod(add(outputs('Facts')?['anchorNumber'], 1), 7))), 6), 7), 1)), 7), outputs('Facts')?['anchorNumber']), equals(mod(div(sub(sub(sub(outputs('Facts')?['todayNumber'], add(mod(add(sub(mod(add(outputs('Facts')?['todayNumber'], 1), 7), if(outputs('Facts')?['hasScheduledDay'], outputs('Facts')?['scheduledWeekday'], mod(add(outputs('Facts')?['anchorNumber'], 1), 7))), 6), 7), 1)), 7), outputs('Facts')?['anchorNumber']), 7), 2), 0)), sub(sub(outputs('Facts')?['todayNumber'], add(mod(add(sub(mod(add(outputs('Facts')?['todayNumber'], 1), 7), if(outputs('Facts')?['hasScheduledDay'], outputs('Facts')?['scheduledWeekday'], mod(add(outputs('Facts')?['anchorNumber'], 1), 7))), 6), 7), 1)), 7), 0))))"
                  },
                  "runAfter": {
                    "Facts": [
                      "Succeeded"
                    ]
                  }
                },
                "PastDue": {
                  "type": "Compose",
                  "inputs": {
                    "missedDue": "@if(outputs('Schedule')?['rolling'], if(less(add(outputs('Schedule')?['resolvedNumber'], outputs('Facts')?['interval']), outputs('Facts')?['todayNumber']), add(outputs('Schedule')?['resolvedNumber'], outputs('Facts')?['interval']), 0), if(and(greater(outputs('Schedule')?['previousDue'], 0), less(outputs('Schedule')?['resolvedNumber'], outputs('Schedule')?['previousDue'])), outputs('Schedule')?['previousDue'], 0))",
                    "daysPastDue": "@if(equals(if(outputs('Schedule')?['rolling'], if(less(add(outputs('Schedule')?['resolvedNumber'], outputs('Facts')?['interval']), outputs('Facts')?['todayNumber']), add(outputs('Schedule')?['resolvedNumber'], outputs('Facts')?['interval']), 0), if(and(greater(outputs('Schedule')?['previousDue'], 0), less(outputs('Schedule')?['resolvedNumber'], outputs('Schedule')?['previousDue'])), outputs('Schedule')?['previousDue'], 0)), 0), 0, sub(outputs('Facts')?['todayNumber'], if(outputs('Schedule')?['rolling'], if(less(add(outputs('Schedule')?['resolvedNumber'], outputs('Facts')?['interval']), outputs('Facts')?['todayNumber']), add(outputs('Schedule')?['resolvedNumber'], outputs('Facts')?['interval']), 0), if(and(greater(outputs('Schedule')?['previousDue'], 0), less(outputs('Schedule')?['resolvedNumber'], outputs('Schedule')?['previousDue'])), outputs('Schedule')?['previousDue'], 0))))",
                    "followUp": "@and(not(outputs('Schedule')?['dueToday']), contains(createArray(1, 3, 5, 7), if(equals(if(outputs('Schedule')?['rolling'], if(less(add(outputs('Schedule')?['resolvedNumber'], outputs('Facts')?['interval']), outputs('Facts')?['todayNumber']), add(outputs('Schedule')?['resolvedNumber'], outputs('Facts')?['interval']), 0), if(and(greater(outputs('Schedule')?['previousDue'], 0), less(outputs('Schedule')?['resolvedNumber'], outputs('Schedule')?['previousDue'])), outputs('Schedule')?['previousDue'], 0)), 0), 0, sub(outputs('Facts')?['todayNumber'], if(outputs('Schedule')?['rolling'], if(less(add(outputs('Schedule')?['resolvedNumber'], outputs('Facts')?['interval']), outputs('Facts')?['todayNumber']), add(outputs('Schedule')?['resolvedNumber'], outputs('Facts')?['interval']), 0), if(and(greater(outputs('Schedule')?['previousDue'], 0), less(outputs('Schedule')?['resolvedNumber'], outputs('Schedule')?['previousDue'])), outputs('Schedule')?['previousDue'], 0))))))"
                  },
                  "runAfter": {
                    "Schedule": [
                      "Succeeded"
                    ]
                  }
                },
                "IfDueToday": {
                  "type": "If",
                  "expression": {
