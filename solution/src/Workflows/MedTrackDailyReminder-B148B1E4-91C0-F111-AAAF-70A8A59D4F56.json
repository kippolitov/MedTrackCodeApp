        "ppa_MedTrackAppUrl (ppa_MedTrackAppUrl)": {
          "defaultValue": "not-configured",
          "type": "String",
          "metadata": {
            "schemaName": "ppa_MedTrackAppUrl"
          }
        }
      },
      "triggers": {
