            "Subject": {
              "type": "Compose",
              "inputs": "@concat('MedTrack: ', if(greater(length(variables('DueItems')), 0), concat(string(length(variables('DueItems'))), ' due today'), ''), if(and(greater(length(variables('DueItems')), 0), greater(length(variables('FollowUpItems')), 0)), ', ', ''), if(greater(length(variables('FollowUpItems')), 0), concat(string(length(variables('FollowUpItems'))), if(equals(length(variables('FollowUpItems')), 1), ' follow-up', ' follow-ups')), ''))",
              "runAfter": {
                "FollowUpNames": [
                  "Succeeded"
                ]
              }
            },
            "Body": {
              "type": "Compose",
              "inputs": "@concat('<p><strong>', outputs('Subject'), '</strong></p>', if(greater(length(variables('DueItems')), 0), concat('<p><strong>Due today</strong></p><ul>', join(body('DueLines'), ''), '</ul>'), ''), if(greater(length(variables('FollowUpItems')), 0), concat('<p><strong>Follow-ups</strong></p><ul>', join(body('FollowUpLines'), ''), '</ul>'), ''), if(startsWith(toLower(coalesce(parameters('ppa_MedTrackAppUrl (ppa_MedTrackAppUrl)'), '')), 'https://'), concat('<p><a href=\"', parameters('ppa_MedTrackAppUrl (ppa_MedTrackAppUrl)'), '\">Open MedTrack</a></p>'), ''))",
              "runAfter": {
                "Subject": [
                  "Succeeded"
                ]
              }
            },
            "Summary": {
              "type": "Compose",
              "inputs": "@concat('Due: ', if(greater(length(variables('DueItems')), 0), join(body('DueNames'), '; '), '–'), decodeUriComponent('%0A'), 'Follow-up: ', if(greater(length(variables('FollowUpItems')), 0), join(body('FollowUpNames'), '; '), '–'))",
              "runAfter": {
                "Body": [
                  "Succeeded"
                ]
              }
            },
            "AnythingToSend": {
              "type": "If",
              "expression": {
                "greater": [
                  "@add(length(variables('DueItems')), length(variables('FollowUpItems')))",
                  0
                ]
              },
              "actions": {
                "Me": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "ListRecords",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "systemusers",
                      "$select": "domainname",
                      "$filter": "Microsoft.Dynamics.CRM.EqualUserId(PropertyName='systemuserid')",
                      "$top": 1
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {},
                  "runtimeConfiguration": {
                    "secureData": {
                      "properties": [
                        "outputs"
                      ]
                    }
                  }
                },
                "SendReminder": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_teams",
                      "operationId": "PostMessageToConversation",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams"
                    },
                    "parameters": {
                      "poster": "Flow bot",
                      "location": "Chat with Flow bot",
                      "body/recipient": "@first(body('Me')?['value'])?['domainname']",
                      "body/messageBody": "@outputs('Body')"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {
                    "Me": [
                      "Succeeded"
                    ]
                  },
                  "runtimeConfiguration": {
                    "secureData": {
                      "properties": [
                        "inputs",
                        "outputs"
                      ]
                    }
                  }
                },
                "MarkMessageAccepted": {
                  "type": "SetVariable",
                  "inputs": {
                    "name": "MessageAccepted",
                    "value": true
                  },
                  "runAfter": {
                    "SendReminder": [
                      "Succeeded"
                    ]
                  }
                },
                "RecordSent": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "UpdateOnlyRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "ppa_reminderruns",
                      "recordId": "@outputs('RunId')",
                      "item/ppa_outcome": 894250001,
                      "item/ppa_duecount": "@length(variables('DueItems'))",
                      "item/ppa_followupcount": "@length(variables('FollowUpItems'))",
                      "item/ppa_summary": "@outputs('Summary')"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {
                    "MarkMessageAccepted": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {
                  "RecordNothingToSend": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "connectionName": "shared_commondataserviceforapps",
                        "operationId": "UpdateOnlyRecord",
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                      },
                      "parameters": {
                        "entityName": "ppa_reminderruns",
                        "recordId": "@outputs('RunId')",
                        "item/ppa_outcome": 894250002,
                        "item/ppa_duecount": 0,
                        "item/ppa_followupcount": 0,
                        "item/ppa_summary": "@concat('Due: –', decodeUriComponent('%0A'), 'Follow-up: –')"
                      },
                      "authentication": "@parameters('$authentication')"
                    },
                    "runAfter": {}
                  }
                }
              },
              "runAfter": {
                "Summary": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "RunId": [
              "Succeeded"
            ]
          }
        },
        "Failure": {
          "type": "Scope",
          "actions": {
            "FailedSteps": {
              "type": "Query",
              "inputs": {
                "from": "@result('Check_and_send')",
                "where": "@equals(item()?['status'], 'Failed')"
              },
              "runAfter": {}
            },
            "FailedSendSteps": {
              "type": "Query",
              "inputs": {
                "from": "@result('AnythingToSend')",
                "where": "@equals(item()?['status'], 'Failed')"
              },
              "runAfter": {
                "FailedSteps": [
                  "Succeeded"
                ]
              }
            },
            "ErrorStep": {
              "type": "Compose",
              "inputs": "@concat(coalesce(first(union(body('FailedSendSteps'), body('FailedSteps')))?['name'], 'Check_and_send'), ' (', string(coalesce(first(union(body('FailedSendSteps'), body('FailedSteps')))?['outputs']?['statusCode'], first(union(body('FailedSendSteps'), body('FailedSteps')))?['code'], 'Unknown')), ')')",
              "runAfter": {
                "FailedSendSteps": [
                  "Succeeded"
                ]
              }
            },
            "IfMessageNotAccepted": {
              "type": "If",
              "expression": {
                "equals": [
                  "@variables('MessageAccepted')",
                  false
                ]
              },
              "actions": {
                "RecordFailed": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "UpdateOnlyRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "ppa_reminderruns",
                      "recordId": "@outputs('RunId')",
                      "item/ppa_outcome": 894250003,
                      "item/ppa_errorstep": "@outputs('ErrorStep')"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {}
                }
              },
              "runAfter": {
                "ErrorStep": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Check_and_send": [
              "Failed",
              "TimedOut"
            ]
          }
        },
        "EndAsFailed": {
          "type": "Terminate",
          "inputs": {
            "runStatus": "Failed",
            "runError": {
              "code": "ReminderFailed",
              "message": "@{coalesce(outputs('ErrorStep'), 'Check_and_send')}"
            }
          },
          "runAfter": {
            "Failure": [
              "Succeeded",
              "Failed",
              "TimedOut"
            ]
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}